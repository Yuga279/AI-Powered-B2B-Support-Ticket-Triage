# Never upload local secrets or local data to Vercel; set environment variables in the Vercel project instead.
.env
.env.*
!.env.example
backend/.env
frontend/.env
backend/data/
node_modules/
**/node_modules/
frontend/dist/
.vercel/

# Coding-agent skill files installed by the Vercel CLI (not part of the app)
.agents/
.claude/
skills-lock.json
