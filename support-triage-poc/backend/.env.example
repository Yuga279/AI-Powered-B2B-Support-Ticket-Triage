# Copy to backend/.env  (PowerShell: Copy-Item backend\.env.example backend\.env)
# Without OPENROUTER_API_KEY, tickets are saved but AI triage is unavailable (they go to human review).

PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
DB_PATH=data/triage.db
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=4

# ---- Hosted storage (Vercel). Leave empty locally to use DB_PATH and UPLOAD_DIR. ----
# Turso database (libsql://<db>-<org>.turso.io) and its auth token
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Private Vercel Blob store for screenshots (set automatically when you connect a Blob store to the project)
BLOB_READ_WRITE_TOKEN=

# First provider tried for text-only tickets: jev | luna | openrouter_llm
TEXT_PROVIDER=jev

# ---- OpenRouter (the only real credential; stays on the backend) ----
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Decisions endpoint used for Jev and Luna (verify with: npm run probe:decisions)
OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
OPENROUTER_APP_URL=http://localhost:5173
OPENROUTER_APP_TITLE=Support Triage POC

# Decision models (OpenRouter slugs)
OPENROUTER_JEV_MODEL=typesafe/jev-1.13
OPENROUTER_LUNA_MODEL=openai/gpt-6-luna-decisions
# off | state_parts | state_input_image   (enable only after probe:decisions confirms image input)
LUNA_IMAGE_MODE=off

# General LLM via chat completions (pick current IDs with: npm run models:openrouter)
OPENROUTER_MODEL=
OPENROUTER_VISION_MODEL=
# json_schema (strict structured outputs) | json_object (JSON mode fallback)
OPENROUTER_JSON_MODE=json_schema
OPENROUTER_MAX_TOKENS=1500

# ---- Reliability ----
PROVIDER_TIMEOUT_MS=20000
PROVIDER_VISION_TIMEOUT_MS=45000
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BASE_MS=500
PROVIDER_RETRY_AFTER_CAP_MS=5000
MAX_LOG_CHARS_TO_PROVIDER=4000

# ---- SLA policy (demonstration values, not validated production thresholds) ----
SLA_BREACH_PROBABILITY_THRESHOLD=0.85
SLA_CRITICAL_SEVERITY=5
SLA_URGENT_DEADLINE_MINUTES=5
# Jev's breach probability is vendor-claimed calibrated; it only auto-escalates if this is true.
SLA_TRUST_VENDOR_CALIBRATION=false
LOW_CONFIDENCE_THRESHOLD=0.5
# Luna predicate score >= this => predicate verdict true (a decision cut-off, not a probability)
LUNA_PREDICATE_DECISION_THRESHOLD=0.5
# Model "needs_human_review" signal >= this => human review
REVIEW_SIGNAL_THRESHOLD=0.5
